<?php

/**
 * @file
 * Permissions for the OpenAI DALL·E module.
 */

use GuzzleHttp\Client as GuzzleClient;

function openai_dalle_permission() {
  return [
    'access openai dalle' => [
      'title' => t('Use OpenAI DALL·E'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function openai_dalle_menu() {
  $items = array();

  $items['admin/config/openai/dalle'] = array(
    'title' => 'OpenAi DALL·E Image Generation',
    'description' => 'Contains a form where you can test the OpenAI API\'s DALL·E (image generation) endpoint.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('openai_dalle_form'),
    'access arguments' => array('access openai dalle'),
    'weight' => -6,
  );

  return $items;
}

/**
 * Provides a form to interact with the OpenAI API's DALL·E (image generation) endpoint.
 */
function openai_dalle_form($form, &$form_state) {
  $openai_config = config('openai.settings');
  $apiKey = key_get_key_value($openai_config->get('api_key'));

  if (empty($apiKey)) {
    form_set_error('', t('API key is not set. Please configure the API key in OpenAI settings.'));
    return $form;
  }

  $api = new OpenAIApi($apiKey);

  $form['prompt'] = [
    '#type' => 'textarea',
    '#title' => t('Prompt'),
    '#description' => t('A text description of the desired image(s). The maximum length is 1000 characters for dall-e-2, 4000 characters for dall-e-3 and gpt-image-1. Please note that OpenAI may reject prompts it deems in violation of their content standards.'),
    '#required' => TRUE,
  ];

  $models = $api->filterModels(['dall', 'gpt-image']);

  $form['model'] = [
    '#type' => 'select',
    '#title' => t('Model'),
    '#options' => $models,
    '#default_value' => 'dall-e-3',
    '#description' => t('The model to use to generate an image.'),
    '#ajax' => [
      'callback' => 'openai_dalle_model_select_callback',
      'wrapper' => 'model-dependent-fields',
    ],
  ];

  // Set initial quality options and default value based on selected model
  $selected_model = isset($form_state['values']['model']) ? $form_state['values']['model'] : 'dall-e-3';
  if ($selected_model === 'gpt-image-1') {
    $quality_options = [
      'auto' => 'Auto',
      'low' => 'Low',
      'medium' => 'Medium',
      'high' => 'High',
    ];
    $quality_default = 'auto';
  } else {
    $quality_options = [
      'hd' => 'HD',
      'standard' => 'Standard',
    ];
    $quality_default = 'hd';
  }

  $form['model_dependent_fields'] = [
    '#prefix' => '<div id="model-dependent-fields">',
    '#suffix' => '</div>',
  ];

  $form['model_dependent_fields']['quality'] = [
    '#type' => 'select',
    '#title' => t('Quality'),
    '#options' => $quality_options,
    '#default_value' => $quality_default,
    '#states' => [
      'visible' => [
        [':input[name="model"]' => ['value' => 'dall-e-3']],
        [':input[name="model"]' => ['value' => 'gpt-image-1']],
      ]
    ],
    '#description' => t('The quality of the image that will be generated. For dall-e-3: hd creates images with finer details and greater consistency across the image. For gpt-image-1: choose from auto, low, medium, or high quality levels.'),
  ];

  $form['model_dependent_fields']['size'] = [
    '#type' => 'select',
    '#title' => t('Size'),
    '#options' => [
      '1024x1024' => '1024x1024', // Default options for 'dall-e-3'.
      '1792x1024' => '1792x1024',
      '1024x1792' => '1024x1792',
    ],
    '#default_value' => '1024x1024', // Default value.
    '#description' => t('The size of the generated images.'),
  ];

  $form['style'] = [
    '#type' => 'select',
    '#title' => t('Style'),
    '#options' => [
      'vivid' => 'Vivid - Generate hyper-real and dramatic images',
      'natural' => 'Natural - Generate more natural, less hyper-real looking images',
    ],
    '#default_value' => 'vivid',
    '#states' => [
      'visible' => [
        ':input[name="model"]' => ['value' => 'dall-e-3']
      ]
    ],
    '#description' => t('The style of the generated images. Must be one of vivid or natural. Vivid causes the model to lean towards generating hyper-real and dramatic images. Natural causes the model to produce more natural, less hyper-real looking images. This parameter only supported for dall-e-3.'),
  ];

  $form['response_format'] = [
    '#type' => 'select',
    '#title' => t('Response Format'),
    '#options' => [
      'url' => 'URL',
      'b64_json' => 'b64_json',
    ],
    '#default_value' => 'url',
    '#states' => [
      'visible' => [
        ':input[name="model"]' => [
          ['value' => 'dall-e-2'],
          ['value' => 'dall-e-3'],
        ]
      ]
    ],
    '#description' => t('The image format of the result. See the <a href="@link">link</a> for more information.', ['@link' => 'https://platform.openai.com/docs/api-reference/images/create#images-create-response_format']),
  ];

  $form['output_format'] = [
    '#type' => 'select',
    '#title' => t('Output Format'),
    '#options' => [
      'png' => 'PNG',
      'jpeg' => 'JPEG',
      'webp' => 'WebP',
    ],
    '#default_value' => 'png',
    '#states' => [
      'visible' => [
        ':input[name="model"]' => ['value' => 'gpt-image-1']
      ]
    ],
    '#description' => t('The format in which the generated images will be created. This parameter is only supported for gpt-image-1.'),
  ];

  $form['filename'] = [
    '#type' => 'textfield',
    '#title' => t('Filename'),
    '#default_value' => 'dalle_image',
    '#states' => [
      'visible' => [
        ':input[name="response_format"]' => ['value' => 'b64_json']
      ]
    ],
    '#required' => TRUE,
    '#description' => t('The filename to save the result as.'),
  ];

  $form['response'] = [
    '#markup' => 'The response will display the generated image below and provide a link to download it.',
  ];

  $form['file'] = [
    '#prefix' => '<div id="openai-dalle-response">',
    '#suffix' => '</div>',
  ];

  $form['actions'] = [
    '#type' => 'actions',
  ];

  $form['actions']['submit'] = [
    '#type' => 'submit',
    '#value' => t('Submit'),
    '#ajax' => [
      'callback' => 'openai_dalle_get_response',
      'wrapper' => 'openai-dalle-response',
      'progress' => [
        'type' => 'throbber',
      ],
    ],
  ];

  return $form;
}

function openai_dalle_model_select_callback($form, &$form_state) {
  $selected_model = $form_state['values']['model'];

  // Update size options based on model
  if ($selected_model === 'dall-e-2') {
    $form['model_dependent_fields']['size']['#options'] = [
      '256x256' => '256x256',
      '512x512' => '512x512',
      '1024x1024' => '1024x1024',
    ];
  } elseif ($selected_model === 'dall-e-3') {
    $form['model_dependent_fields']['size']['#options'] = [
      '1024x1024' => '1024x1024',
      '1792x1024' => '1792x1024',
      '1024x1792' => '1024x1792',
    ];
  } elseif ($selected_model === 'gpt-image-1') {
    $form['model_dependent_fields']['size']['#options'] = [
      '1024x1024' => '1024x1024',
      '1024x1536' => '1024x1536',
      '1536x1024' => '1536x1024',
      '1024x1792' => '1024x1792',
      '1792x1024' => '1792x1024',
    ];
  }

  // Update quality options based on model
  if ($selected_model === 'gpt-image-1') {
    $form['model_dependent_fields']['quality']['#options'] = [
      'auto' => 'Auto',
      'low' => 'Low',
      'medium' => 'Medium',
      'high' => 'High',
    ];
    $form['model_dependent_fields']['quality']['#default_value'] = 'auto';
  } else {
    $form['model_dependent_fields']['quality']['#options'] = [
      'hd' => 'HD',
      'standard' => 'Standard',
    ];
    $form['model_dependent_fields']['quality']['#default_value'] = 'hd';
  }

  // Ensure the default values are set
  $form['model_dependent_fields']['size']['#default_value'] = array_key_first($form['model_dependent_fields']['size']['#options']);

  return $form['model_dependent_fields'];
}

/**
 * Form validation handler for the DALL-E form.
 */
function openai_dalle_form_validate($form, &$form_state) {
  $prompt = $form_state['values']['prompt'];
  $model = $form_state['values']['model'];
  $size = $form_state['values']['size'];
  $quality = $form_state['values']['quality'];

  $dalle_2_sizes = ['256x256', '512x512', '1024x1024'];
  $dalle_3_sizes = ['1024x1024', '1792x1024', '1024x1792'];
  $gpt_image_1_sizes = ['1024x1024', '1024x1536', '1536x1024', '1024x1792', '1792x1024'];

  // Define valid quality options for each model dynamically.
  $valid_quality_options = [];
  if ($model === 'gpt-image-1') {
    $valid_quality_options = ['auto', 'low', 'medium', 'high'];
  } elseif ($model === 'dall-e-3') {
    $valid_quality_options = ['hd', 'standard'];
  }

  // Validate prompt length
  if ($model === 'dall-e-2' && mb_strlen($prompt) > 1000) {
    form_set_error('prompt', 'The input cannot exceed 1000 characters for the dall-e-2 model.');
  }

  if (($model === 'dall-e-3' || $model === 'gpt-image-1') && mb_strlen($prompt) > 4000) {
    form_set_error('prompt', 'The input cannot exceed 4000 characters for the dall-e-3 and gpt-image-1 models.');
  }

  // Validate size options
  if ($model === 'dall-e-2' && !in_array($size, $dalle_2_sizes)) {
    form_set_error('size', 'This size is not supported by the dall-e-2 model.');
  }

  if ($model === 'dall-e-3' && !in_array($size, $dalle_3_sizes)) {
    form_set_error('size', 'This size is not supported by the dall-e-3 model.');
  }

  if ($model === 'gpt-image-1' && !in_array($size, $gpt_image_1_sizes)) {
    form_set_error('size', 'This size is not supported by the gpt-image-1 model.');
  }

  // Validate quality options dynamically based on the model.
  if (!empty($valid_quality_options) && !in_array($quality, $valid_quality_options)) {
    form_set_error('quality', t('Invalid quality option selected for the @model model.', ['@model' => $model]));
  }
}

/**
 * Renders the response.
 *
 * @param array $form
 *   The form array.
 * @param array $form_state
 *   The form state.
 *
 * @return array
 *   The modified form element.
 */
function openai_dalle_get_response($form, &$form_state) {
  // Initialize storage if it doesn't exist
  if (!isset($form_state['storage']) || !is_array($form_state['storage'])) {
    $form_state['storage'] = [];
  }

  $storage = $form_state['storage'];

  if (!empty($storage['fid'])) {
    // Load the file entity using the file ID.
    $file = file_load($storage['fid']);
    if ($file) {
      $file_url = file_create_url($file->uri);

      // Generate the markup for displaying the image and providing the link.
      $form['file']['#markup'] = t('
        <div class="openai-dalle-result">
          <p><strong>Generated Image:</strong></p>
          <img src="@file_url" alt="Generated Image" style="max-width: 100%; border: 1px solid #ccc; padding: 10px; display: block;" />
          <p><a href="@file_url" target="_blank" download>@filename</a></p>
        </div>', [
        '@file_url' => $file_url,
        '@filename' => $file->filename,
      ]);
    } else {
      $form['file']['#markup'] = t('The file could not be loaded.');
    }
  } else {
    $form['file']['#markup'] = t('No image generated yet.');
  }

  return $form['file'];
}

/**
 * Form submit handler for the DALL-E form.
 */
function openai_dalle_form_submit($form, &$form_state) {
  $openai_config = config('openai.settings');
  $apiKey = key_get_key_value($openai_config->get('api_key'));

  if (empty($apiKey)) {
    form_set_error('', t('API key is not set. Please configure the API key in OpenAI settings.'));
    return;
  }

  $api = new OpenAIApi($apiKey);

  // Retrieve form values.
  $prompt = $form_state['values']['prompt'];
  $model = $form_state['values']['model'];
  $quality = $form_state['values']['quality'];
  $size = $form_state['values']['size'];
  $style = $form_state['values']['style'];
  $format = $form_state['values']['response_format'];
  $output_format = $form_state['values']['output_format'];
  $filename_base = $form_state['values']['filename'];

  $file_scheme = file_default_scheme();
  $timestamp = REQUEST_TIME;

  // Use output_format for filename extension if gpt-image-1, otherwise default to png
  $file_extension = 'png';
  if ($model === 'gpt-image-1' && !empty($output_format)) {
    $file_extension = $output_format === 'jpeg' ? 'jpg' : $output_format;
  }

  $unique_filename = $filename_base . '-' . $timestamp . '.' . $file_extension;

  try {
    // Generate the image using the OpenAI API.
    $result = $api->images($model, $prompt, $size, $format, $quality, $style, $output_format);

    if ($format === 'b64_json') {
      // Validate base64 data using a regex pattern.
      if (preg_match('/^([A-Za-z0-9+\/]{4})*([A-Za-z0-9+\/]{2}==|[A-Za-z0-9+\/]{3}=)?$/', $result)) {
        $data = base64_decode($result);

        if ($data === false) {
          form_set_error('', t('Failed to decode the Base64 image data.'));
          return;
        }

        $file = file_save_data($data, $file_scheme . '://' . $unique_filename, FILE_EXISTS_REPLACE);

        if ($file) {
          // Add file usage to ensure it appears in the media library.
          file_usage_add($file, 'openai_dalle', 'module', $file->fid);

          $form_state['storage'] = [
            'filename' => $file->filename,
            'filepath' => file_create_url($file->uri),
            'fid' => $file->fid,
            'format' => 'base64',
          ];
        } else {
          form_set_error('', t('Failed to save the image to the file system.'));
        }
      } else {
        form_set_error('', t('Invalid Base64 image data received.'));
      }
    } else {
      // Handle URL response
      $client = new GuzzleHttp\Client();
      $response = $client->get($result);

      if ($response->getStatusCode() === 200) {
        $file = file_save_data($response->getBody(), $file_scheme . '://' . $unique_filename, FILE_EXISTS_REPLACE);

        if ($file) {
          // Add file usage to ensure it appears in the media library.
          file_usage_add($file, 'openai_dalle', 'module', $file->fid);

          $form_state['storage'] = [
            'filename' => $file->filename,
            'filepath' => file_create_url($file->uri),
            'fid' => $file->fid,
            'format' => $format,
          ];
        } else {
          form_set_error('', t('Failed to save the image to the file system.'));
        }
      } else {
        form_set_error('', t('Failed to download the image from the URL.'));
      }
    }
  } catch (Exception $e) {
    form_set_error('', t('Error generating image: @message', ['@message' => $e->getMessage()]));
  }

  $form_state['rebuild'] = TRUE;
}
