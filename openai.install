<?php

/**
 * Implements hook_requirements().
 */
function openai_requirements($phase) {
  $requirements = [];

  // Check PHP version requirement for both install and runtime phases.
  if ($phase == 'install' || $phase == 'runtime') {
    if (version_compare(PHP_VERSION, '8.2.0', '<')) {
      $requirements['openai_php'] = [
        'title' => t('OpenAI PHP Version'),
        'value' => PHP_VERSION,
        'severity' => REQUIREMENT_ERROR,
        'description' => t('OpenAI module requires PHP 8.2.0 or higher. Your current version is @version. Please upgrade PHP before installing this module.', ['@version' => PHP_VERSION]),
      ];
    }
  }

  if ($phase == 'runtime') {
    // Check if the Key module is enabled.
    if (!module_exists('key')) {
      $requirements['openai'] = [
        'title' => t('OpenAI'),
        'value' => t('Key module not enabled'),
        'severity' => REQUIREMENT_ERROR,
        'description' => t(
          'The OpenAI module requires the Key module to securely manage the API key. Enable the Key module from the <a href="@modules">modules page</a>.',
          ['@modules' => url('admin/modules')]
        ),
      ];
    } else {
      // Check if a valid key has been selected in the OpenAI settings.
      $config = config_get('openai.settings');
      $key_id = $config['api_key'];

      if (!empty($key_id) && key_get_key($key_id)) {
        $requirements['openai'] = [
          'title' => t('OpenAI'),
          'value' => t('API key detected and managed via Key module'),
          'severity' => REQUIREMENT_OK,
        ];
      } else {
        $requirements['openai'] = [
          'title' => t('OpenAI'),
          'value' => t('API key not configured'),
          'severity' => REQUIREMENT_ERROR,
          'description' => t(
            'An API key is required for OpenAI functionality. Configure the key in the <a href="@settings">OpenAI settings</a>.',
            ['@settings' => url('admin/config/openai/settings')]
          ),
        ];
      }
    }

    // ---- Runtime diagnostics for SDK source and version (Composer Manager vs module vendor) ----
    // Ensure autoloader for runtime diagnostics.
    $src_ref =& backdrop_static('openai_sdk_source');
    if (!class_exists('OpenAI') && !class_exists('OpenAI\\Client')) {
      if (module_exists('composer_manager') && function_exists('composer_manager_register_autoloader')) {
        composer_manager_register_autoloader();
        $src_ref = $src_ref ?: 'composer_manager';
      }
      else {
        $autoload = BACKDROP_ROOT . '/' . backdrop_get_path('module', 'openai') . '/vendor/autoload.php';
        if (file_exists($autoload)) {
          require_once $autoload;
          $src_ref = $src_ref ?: 'module_vendor';
        }
      }
    }

    // If the client is available, report version and file locations.
    if (class_exists('OpenAI') || class_exists('OpenAI\\Client')) {
      // Version detection via Composer InstalledVersions when available.
      $version = NULL;
      if (class_exists('Composer\\InstalledVersions') && method_exists('Composer\\InstalledVersions', 'getPrettyVersion')) {
        try {
          $version = Composer\InstalledVersions::getPrettyVersion('openai-php/client');
          // Normalize version to avoid double "v" prefix in output.
          if (is_string($version) && strlen($version) > 0 && $version[0] === 'v') {
            $version = ltrim($version, 'v');
          }
        }
        catch (Exception $e) {
          // leave as NULL
        }
      }

      // Reflection to find which vendor provides the classes.
      try {
        $root_ref = new ReflectionClass('OpenAI');
        $root_file = $root_ref->getFileName();
      }
      catch (Exception $e) {
        $root_file = t('Unknown');
      }
      try {
        if (class_exists('OpenAI\\Client')) {
          $client_ref = new ReflectionClass('OpenAI\\Client');
          $client_file = $client_ref->getFileName();
        }
        else {
          $client_file = t('Class not found');
        }
      }
      catch (Exception $e) {
        $client_file = t('Unknown');
      }

      // Attempt to infer SDK source from file paths if not recorded earlier.
      $src_ref =& backdrop_static('openai_sdk_source');
      if (empty($src_ref)) {
        $module_vendor = BACKDROP_ROOT . '/' . backdrop_get_path('module', 'openai') . '/vendor/';
        $files_vendor = BACKDROP_ROOT . '/files/vendor/';
        $composer_vendor = BACKDROP_ROOT . '/vendor/';
        $path_to_check = is_string($root_file) ? $root_file : (is_string($client_file) ? $client_file : '');
        if ($path_to_check) {
          if (strpos($path_to_check, $module_vendor) !== FALSE) {
            $src_ref = 'module_vendor';
          }
          elseif (strpos($path_to_check, $files_vendor) !== FALSE || (strpos($path_to_check, $composer_vendor) !== FALSE && strpos($path_to_check, $module_vendor) === FALSE)) {
            // Treat Composer-managed locations (files/vendor or project vendor) as composer_manager.
            $src_ref = 'composer_manager';
          }
        }
      }
      $source_text = function_exists('openai_get_sdk_source') ? openai_get_sdk_source() : 'Unknown';

      $requirements['openai_php_client'] = array(
        'title' => t('OpenAI PHP Client'),
        'value' => $version ? t('Installed v@v', array('@v' => $version)) : t('Installed (version unknown)'),
        'severity' => REQUIREMENT_INFO,
      );

      $requirements['openai_sdk_source'] = array(
        'title' => t('OpenAI SDK load source'),
        'value' => t('@source (@file)', array('@source' => $source_text, '@file' => $root_file)),
        'description' => t('OpenAI\\Client file: @file', array('@file' => $client_file)),
        'severity' => REQUIREMENT_INFO,
      );
    }
    else {
      $requirements['openai_php_client'] = array(
        'title' => t('OpenAI PHP Client'),
        'value' => t('Not available'),
        'description' => t('Enable Composer Manager or ensure the module vendor/autoload.php exists.'),
        'severity' => REQUIREMENT_WARNING,
      );
    }
  }

  return $requirements;
}

/**
 * Implements hook_uninstall().
 */
function openai_uninstall() {
  // Delete configuration on uninstall.
  config('openai.settings')->delete();
}
